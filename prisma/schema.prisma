generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model admin {
  id        String          @id @default(uuid())
  email     String          @unique
  name      String?
  password  String?
  avatar    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  role      AdminRole       @default(ADMIN)

  accounts  AdminAccount[]
  news      news[]

  @@map("admin")
}

model AdminAccount {
  id                String   @id @default(uuid())
  provider          String   // "google"
  providerAccountId String

  admin   admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId String

  @@unique([provider, providerAccountId])
  @@map("admin_accounts")
}

model category {
  id        Int      @id @default(autoincrement())
  name      String   @unique(map: "Category_name_key")
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      news[]

  @@map("category")
}

model news {
  id         String   @id @default(uuid())
  title      String
  content    String   @db.Text
  authorId   String
  thumbnail  String
  slug       String @unique
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  admin      admin    @relation(fields: [authorId], references: [id], map: "News_authorId_fkey", onDelete : Cascade)
  category   category @relation(fields: [categoryId], references: [id], map: "News_categoryId_fkey", onDelete : Restrict)

  @@index([authorId], map: "News_authorId_fkey")
  @@index([categoryId], map: "News_categoryId_fkey")

  @@map("news")
}

model Lectureship {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(50)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments DosenLectureship[]

  @@map("lectureships")
}

model dosen {
  id            String             @id @default(uuid())
  name          String
  expertise     String
  photo         String
  teaching      String
  research      String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  positions     DosenLectureship[]

  @@map("dosen")
}

model DosenLectureship {
  id            Int         @id @default(autoincrement())
  dosenId       String
  lectureshipId Int
  startDate     DateTime    @db.Date
  endDate       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  dosen         dosen       @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  lectureship   Lectureship @relation(fields: [lectureshipId], references: [id], onDelete: Cascade)

  @@index([dosenId], map: "DosenLectureship_dosenId_fkey")
  @@index([lectureshipId], map: "DosenLectureship_lectureshipId_fkey")
  @@map("dosen_lectureships")
}

model StatisticStudent  {
  id                 String @id @default(uuid())
  year              Int @unique @db.UnsignedMediumInt
  enteredStudents    Int @db.UnsignedMediumInt
  graduatedStudents  Int @db.UnsignedMediumInt
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("statistic_student")
}

model VisionMission {
  id       Int @id @default(autoincrement())
  vision   String @db.Text
  mission  String @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("vission_mission")
}

model Partnership {
  id            String      @id @default(uuid())
  name          String   @db.VarChar(255)
  photo         String?   @db.VarChar(255)
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("partnerships")
}

model Alumni {
  id       String @id @default(uuid())
  name      String
  photo     String?
  video     String
  message   String @db.Text
  year      Int @db.UnsignedMediumInt
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("alumni")
}

model Study {
  id                 Int @id @default(autoincrement())
  source             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("study")
}

model Achievement {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  achievementName String @db.VarChar(255)
  link            String   @db.VarChar(255)
  achievedAt      DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("achievements")
}

model OrganizationalStructure {
  image       String @id @db.VarChar(255)
  description String @db.Text

  @@map("organizational_structure")
}
