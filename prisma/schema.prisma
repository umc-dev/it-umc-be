generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  id        String         @id @default(uuid())
  email     String         @unique
  name      String?
  password  String?
  avatar    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  role      AdminRole      @default(ADMIN)
  accounts  AdminAccount[]
  news      news[]
  dosen     dosen[]

  @@map("admin")
}

model AdminAccount {
  id                String @id @default(uuid())
  provider          String
  providerAccountId String
  adminId           String
  admin             admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([adminId], map: "admin_accounts_adminId_fkey")
  @@map("admin_accounts")
}

model category {
  id        Int      @id @default(autoincrement())
  name      String   @unique(map: "Category_name_key")
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      news[]

  @@map("category")
}

model news {
  id         String   @id @default(uuid())
  title      String
  content    String   @db.Text
  authorId   String
  thumbnail  String
  slug       String   @unique
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  admin      admin    @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "News_authorId_fkey")
  category   category @relation(fields: [categoryId], references: [id], map: "News_categoryId_fkey")

  @@index([authorId], map: "News_authorId_fkey")
  @@index([categoryId], map: "News_categoryId_fkey")
  @@map("news")
}

model Lectureship {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(50)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assignments DosenLectureship[]

  @@map("lectureships")
}

model dosen {
  id              String             @id @default(uuid())
  prodi           Prodi              @default(S1)
  name            String
  expertise       String
  photo           String
  teaching        String
  research        String
  education       String?            @db.Text
  description     String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  nidn            String             @unique
  email           String             @unique
  positions       DosenLectureship[]
  dosenTridharmas DosenTridharma[]
  admin           admin    @relation(fields: [email], references: [email], onDelete: Cascade, map: "dosen_email_fkey")

  @@index([email], map: "dosen_email_fkey")
  @@map("dosen")
}

model DosenTridharma {
  id          Int                    @id @default(autoincrement())
  dosenId     String
  category    DosenTridharmaCategory
  title       String
  year        Int
  description String                 @db.Text
  link        String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  dosen       dosen                  @relation(fields: [dosenId], references: [id], onDelete: Cascade)

  @@index([dosenId])
  @@map("dosen_tridharmas")
}

enum DosenTridharmaCategory {
  PENGABDIAN
  PENGAJARAN
  PENELITIAN
}


model DosenLectureship {
  id            Int         @id @default(autoincrement())
  dosenId       String
  lectureshipId Int
  startDate     DateTime    @db.Date
  endDate       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  dosen         dosen       @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  lectureship   Lectureship @relation(fields: [lectureshipId], references: [id], onDelete: Cascade)

  @@index([dosenId], map: "DosenLectureship_dosenId_fkey")
  @@index([lectureshipId], map: "DosenLectureship_lectureshipId_fkey")
  @@map("dosen_lectureships")
}

model StatisticStudent {
  id                String   @id @default(uuid())
  year              Int      @db.UnsignedMediumInt
  prodi             Prodi    @default(S1)
  enteredStudents   Int      @db.UnsignedMediumInt
  graduatedStudents Int      @db.UnsignedMediumInt
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([year, prodi])
  @@map("statistic_student")
}

model VisionMission {
  id        Int      @id @default(autoincrement())
  prodi     Prodi    @default(S1)
  vision    String   @db.Text
  mission   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vission_mission")
}

model Partnership {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  photo     String?  @db.VarChar(255)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partnerships")
}

model Alumni {
  id        String   @id @default(uuid())
  name      String
  video     String
  message   String   @db.Text
  year      Int      @db.UnsignedMediumInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photo     String?

  @@map("alumni")
}

model Study {
  id        Int      @id @default(autoincrement())
  prodi     Prodi    @default(S1)
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study")
}

model Achievement {
  id              Int      @id @default(autoincrement())
  prodi     Prodi    @default(S1)
  name            String   @db.VarChar(255)
  link            String   @db.VarChar(255)
  achievedAt      DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  achievementName String   @db.VarChar(255)

  @@map("achievements")
}

model OrganizationalStructure {
  image       String @id @db.VarChar(255)
  description String @db.Text

  @@map("organizational_structure")
}

model Facility {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.Text
  photo       String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("facilities")
}

model ChatbotContext {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  context   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chatbot_contexts")
}

model ChatbotFile {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(255)
  filePath  String   @db.VarChar(255)
  fileUrl   String   @db.VarChar(255)
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chatbot_files")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  DOSEN
}

enum Prodi {
  S1
  D3
}


